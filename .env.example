# Copia a `.env` (está en .gitignore) y rellena. Todo esto es PÚBLICO: va en el
# bundle. Los secretos (cuenta de servicio de Firebase) van al Worker con
# `wrangler secret put`, nunca aquí. Ver docs/multiplayer-setup.md.

# Proyecto de Firebase del multijugador (Consola → Configuración del proyecto →
# Tus apps → Configuración del SDK). Sin estas dos primeras el multijugador
# queda apagado y la UI lo dice.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=

# Kovalt API (lista blanca de cuentas). Por defecto la real.
VITE_KOVALT_API_URL=https://api.kovalt.mx
