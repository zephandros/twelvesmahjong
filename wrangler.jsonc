{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "twelvesmahjong",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-26",

  // El sitio estático (dist/) lo sirve el propio Worker vía el binding ASSETS.
  //
  // `run_worker_first` se deja en su valor por defecto (false) A PROPÓSITO: así
  // una petición que corresponde a un asset se sirve SIN invocar el Worker. Si
  // alguien inunda /api/, la portada y la partida de un jugador siguen en pie.
  //
  // `not_found_handling: "404-page"` sirve public/404.html con un 404 REAL. Con
  // "single-page-application" se devolvería 200 y volveríamos a los soft-404
  // que documenta CLAUDE.md.
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },

  // El multijugador vive en Firebase (Realtime Database); el Worker solo emite
  // las sesiones. El Durable Object `GameRoom` de la primera versión se retira
  // con la migración v2 (hace falta declararlo: Cloudflare no borra clases
  // desplegadas por omisión).
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] },
    { "tag": "v2", "deleted_classes": ["GameRoom"] }
  ],

  "vars": {
    "PB_URL": "https://api.kovalt.mx",
    // Id del proyecto de Firebase (el mismo de VITE_FIREBASE_PROJECT_ID en .env).
    "FIREBASE_PROJECT_ID": "twelves-mahjong-db",
    // URL de la Realtime Database (la misma de VITE_FIREBASE_DATABASE_URL); la
    // usa la limpieza de salas. Si se omite, worker/cleanup.ts asume la
    // instancia por omisión `https://<proyecto>-default-rtdb.firebaseio.com`.
    "FIREBASE_DATABASE_URL": "https://twelves-mahjong-db-default-rtdb.firebaseio.com"
  },

  // Limpieza diaria de salas caducadas en la RTDB (worker/cleanup.ts): salas
  // de más de 24 h, o terminadas hace más de 1 h. A mano en local:
  // `npx wrangler dev --test-scheduled` + `curl "http://localhost:8787/__scheduled"`
  // (ver docs/multiplayer-setup.md).
  "triggers": { "crons": ["17 4 * * *"] },

  // Frena la fuerza bruta de códigos de sala: 20 sesiones de invitado por
  // minuto e IP. Gratis en el plan free.
  "ratelimits": [
    { "name": "GUEST_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }
  ],

  "observability": { "enabled": true }
}
