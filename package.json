{
  "name": "twelves-mahjong",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Mahjong Twelves (麻雀トウェルブス) — single-player offline riichi mahjong",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p worker/tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "dev:worker": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "tsc -p worker/tsconfig.json --noEmit",
    "assets:tiles": "node scripts/build-tiles.mjs",
    "assets:i18n": "node scripts/build-i18n.mjs",
    "assets:icons": "node scripts/build-icons.mjs",
    "assets:fonts": "node scripts/fetch-fonts.mjs && python scripts/subset-jp.py",
    "assets:audio": "node scripts/build-audio.mjs",
    "assets:logo": "powershell -NoProfile -File scripts/bake-logo.ps1",
    "assets:portraits": "powershell -NoProfile -File scripts/bake-portraits.ps1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260726.1",
    "@types/node": "^26.1.1",
    "svgo": "^4.0.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.2.4",
    "wrangler": "^4.114.0"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "pocketbase": "^0.27.3"
  }
}
